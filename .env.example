# Open Accountant — Environment Variables
# Copia este archivo a .env y completa tus valores.
# Al instalar por primera vez: cp .env.example .env

# ── Seguridad ──────────────────────────────────────────────────────────────────
# Clave secreta usada para firmar tokens (cámbiala en producción)
SECRET_KEY=change_me_in_production

# ── Servidor ───────────────────────────────────────────────────────────────────
# HOST y PORT también pueden configurarse en config.ini [general]
# HOST=0.0.0.0
# PORT=5001

# ── Integraciones opcionales ───────────────────────────────────────────────────
# OPENAI_API_KEY=
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
