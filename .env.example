# Open Accountant — Environment Variables
# Copy this file to .env and fill in your own values.
# First-time setup example: cp .env.example .env

# ── Server ────────────────────────────────────────────────────────────────────
# HOST and PORT can also be configured in config.ini under [general].
# Managed platforms such as Heroku set PORT automatically at runtime.
# HOST=0.0.0.0
# PORT=5001

# ── Database ──────────────────────────────────────────────────────────────────
# PostgreSQL target for production/shared hosting.
# If omitted, the app falls back to a local single SQLite database at data/open_accountant.db.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/open_accountant

# ── Optional integrations ─────────────────────────────────────────────────────
# OPENAI_API_KEY=
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=

AUTH_BOOTSTRAP_ADMIN_USERNAME=admin
AUTH_BOOTSTRAP_ADMIN_PASSWORD=admin1234

# ── Headless API access (Alexa skill) ─────────────────────────────────────────
# Shared secret accepted in the "X-API-Key" header by every /api endpoint.
# Leave empty to disable header authentication (cookie-only, the default).
# ALEXA_API_KEY=
# Existing username the API key acts as. Defaults to "admin".
# ALEXA_API_USERNAME=admin
