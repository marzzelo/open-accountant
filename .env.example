# Open Accountant — Environment Variables
# Copy this file to .env and fill in your own values.
# First-time setup example: cp .env.example .env

# ── Server ────────────────────────────────────────────────────────────────────
# HOST and PORT can also be configured through the in-app Settings panel.
# Managed platforms such as Heroku set PORT automatically at runtime.
# HOST=0.0.0.0
# PORT=5001

# ── Database ──────────────────────────────────────────────────────────────────
# PostgreSQL connection URL. Required — Open Accountant will refuse to start
# if DATABASE_URL is empty.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/open_accountant

# ── Optional integrations ─────────────────────────────────────────────────────
# OPENAI_API_KEY=
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
