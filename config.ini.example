# Open Accountant — Legacy configuration template
# This file is kept only for one-time migration into data/app_meta.sqlite3.
# New installs store app settings in SQLite and do not require config.ini.

[general]
# Name of the active accounting book (corresponds to data/<name>.db)
current_book = home

# Server bind address. Use 0.0.0.0 to allow LAN/Tailscale access.
host = 127.0.0.1

# Server port
port = 5001

[app]
# Application display name
name = Open Accountant

# Default UI language: en | es
language = en
