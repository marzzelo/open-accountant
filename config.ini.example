# Open Accountant — Legacy configuration template
# This file is kept only for one-time migration into data/app_meta.sqlite3.
# New installs store app settings in SQLite and do not require config.ini.

[general]
# Server bind address. Use 0.0.0.0 to allow LAN/Tailscale access.
host = 127.0.0.1

# Server port
port = 5001

[app]
# Application display name
name = Open Accountant

# Default UI language: en | es
language = en

[finance]
# Official USD buy rate used when entering transactions in USD
usd_official_buy_ars = 0.00

# Official USD sell rate
usd_official_sell_ars = 0.00

# Blue USD buy rate
usd_blue_buy_ars = 0.00

# Blue USD sell rate
usd_blue_sell_ars = 0.00

# Card USD rate, calculated as official sell * 1.30
usd_card_ars = 0.00

# ISO timestamp of the last manual or automatic update
usd_official_last_update =
