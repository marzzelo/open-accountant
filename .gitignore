# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
.eggs/

# ── Virtual environments ───────────────────────────────────────────────────────
venv/
env/
.venv/
ENV/

# ── Environment & secrets ─────────────────────────────────────────────────────
.env
private/
# Keep the example file:
!.env.example

# ── Data directory (any backups or exports that may contain user data) ──────
data/*.bak
data/*.dump
data/*.sql
# Keep the directory placeholder:
!data/.gitkeep

# ── Logs ──────────────────────────────────────────────────────────────────────
*.log
nohup.out
/tmp/*.log

# ── Compiled gettext catalogs ─────────────────────────────────────────────────
locales/**/messages.mo

# ── OS artifacts ──────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
*.swp
*~
.idea/
.vscode/settings.json

# ── Test / scratch databases ──────────────────────────────────────────────────
data/test*.db
data/home_empty*.db
