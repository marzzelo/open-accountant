msgstr "Fórmula"

msgid "kpi.info.savings_rate.name"
msgstr "Tasa de ahorro"

msgid "kpi.info.savings_rate.def"
msgstr "Porcentaje de los ingresos del período que se convierte en resultado neto positivo. Un valor alto indica buena salud financiera."

msgid "kpi.info.savings_rate.formula"
msgstr "(Ingresos − Gastos) / Ingresos"

msgid "kpi.info.debt_ratio.name"
msgstr "Ratio de endeudamiento"

msgid "kpi.info.debt_ratio.def"
msgstr "Proporción del activo total financiada con deuda. Valores superiores a 0,5 indican alto apalancamiento financiero."

msgid "kpi.info.debt_ratio.formula"
msgstr "Pasivos totales / Activos totales"

msgid "kpi.info.current_ratio.name"
msgstr "Ratio corriente (liquidez)"

msgid "kpi.info.current_ratio.def"
msgstr "Capacidad de cubrir las obligaciones de corto plazo con los activos corrientes disponibles. Se recomienda un valor mayor a 1."

msgid "kpi.info.current_ratio.formula"
msgstr "Activos corrientes / Pasivos corrientes"

msgid "kpi.info.quick_ratio.name"
msgstr "Prueba ácida"

msgid "kpi.info.quick_ratio.def"
msgstr "Mide la capacidad de pagar pasivos corrientes usando solo activos líquidos, sin depender de la venta de inventario. Se recomienda un valor mayor a 1."

msgid "kpi.info.quick_ratio.formula"
msgstr "Activos líquidos / Pasivos corrientes"

msgid "kpi.info.runway_months.name"
msgstr "Runway de liquidez"

msgid "kpi.info.runway_months.def"
msgstr "Cantidad de meses que el nivel actual de activos líquidos puede sostener los gastos esenciales mensuales sin ingresos adicionales."

msgid "kpi.info.runway_months.formula"
msgstr "Activos líquidos / Gasto mensual esencial"

msgid "kpi.info.total_runway.name"
msgstr "Runway total"

msgid "kpi.info.total_runway.def"
msgstr "Cantidad de meses que el nivel actual de activos totales puede sostener los gastos totales mensuales promedio, sin ingresos adicionales."

msgid "kpi.info.total_runway.formula"
msgstr "Activos totales / Gasto mensual total promedio"

msgid "kpi.info.total_assets_basic_runway.name"
msgstr "Cobertura del Activo total sobre gastos básicos promedio"

msgid "kpi.info.total_assets_basic_runway.def"
msgstr "Cantidad de meses que el Activo total actual puede cubrir el gasto mensual base promedio, sin ingresos adicionales."

msgid "kpi.info.total_assets_basic_runway.formula"
msgstr "Activo total / Gasto mensual base promedio"

msgid "kpi.info.net_worth.name"
msgstr "Patrimonio neto"

msgid "kpi.info.net_worth.def"
msgstr "Valor neto acumulado: diferencia entre el total de activos y el total de pasivos. Refleja la riqueza real disponible."

msgid "kpi.info.net_worth.formula"
msgstr "Activos totales − Pasivos totales"

msgid "kpi.info.top_asset.name"
msgstr "Concentración del activo principal"

msgid "kpi.info.top_asset.def"
msgstr "Peso porcentual del activo con mayor saldo sobre el total de activos. Valores muy altos indican baja diversificación."

msgid "kpi.info.top_asset.formula"
msgstr "Saldo del activo principal / Total activos"

msgid "kpi.info.top_expense.name"
msgstr "Concentración del gasto principal"

msgid "kpi.info.top_expense.def"
msgstr "Peso porcentual de la categoría de gasto más relevante sobre el total de gastos del período."

msgid "kpi.info.top_expense.formula"
msgstr "Gasto de la categoría principal / Total gastos"

msgid "kpi.info.delta_net_worth.name"
msgstr "Delta patrimonial"

msgid "kpi.info.delta_net_worth.def"
msgstr "Diferencia proyectada en el patrimonio neto al final del horizonte entre el escenario con series y el escenario base."

msgid "kpi.info.delta_net_worth.formula"
msgstr "Patrimonio (con series) − Patrimonio (base)"

msgid "kpi.info.delta_runway.name"
msgstr "Delta runway"

msgid "kpi.info.delta_runway.def"
msgstr "Diferencia proyectada en los meses de runway al final del horizonte entre el escenario con series y el escenario base."

msgid "kpi.info.delta_runway.formula"
msgstr "Runway (con series) − Runway (base)"

