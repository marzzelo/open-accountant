msgstr "Formula"

msgid "kpi.info.savings_rate.name"
msgstr "Savings rate"

msgid "kpi.info.savings_rate.def"
msgstr "Percentage of the period's income that becomes a positive net result. A high value indicates good financial health."

msgid "kpi.info.savings_rate.formula"
msgstr "(Income − Expenses) / Income"

msgid "kpi.info.debt_ratio.name"
msgstr "Debt ratio"

msgid "kpi.info.debt_ratio.def"
msgstr "Proportion of total assets financed by debt. Values above 0.5 indicate high financial leverage."

msgid "kpi.info.debt_ratio.formula"
msgstr "Total liabilities / Total assets"

msgid "kpi.info.current_ratio.name"
msgstr "Current ratio (liquidity)"

msgid "kpi.info.current_ratio.def"
msgstr "Ability to cover short-term obligations with available current assets. A value greater than 1 is recommended."

msgid "kpi.info.current_ratio.formula"
msgstr "Current assets / Current liabilities"

msgid "kpi.info.quick_ratio.name"
msgstr "Quick ratio (acid test)"

msgid "kpi.info.quick_ratio.def"
msgstr "Measures the ability to pay current liabilities using only liquid assets, without relying on inventory sales. A value greater than 1 is recommended."

msgid "kpi.info.quick_ratio.formula"
msgstr "Liquid assets / Current liabilities"

msgid "kpi.info.runway_months.name"
msgstr "Liquidity runway"

msgid "kpi.info.runway_months.def"
msgstr "Number of months the current level of liquid assets can sustain monthly essential expenses without additional income."

msgid "kpi.info.runway_months.formula"
msgstr "Liquid assets / Monthly essential expense"

msgid "kpi.info.total_runway.name"
msgstr "Total runway"

msgid "kpi.info.total_runway.def"
msgstr "Number of months the current level of total assets can sustain average total monthly expenses, without additional income."

msgid "kpi.info.total_runway.formula"
msgstr "Total assets / Average total monthly expense"

msgid "kpi.info.total_assets_basic_runway.name"
msgstr "Total-assets coverage of average basic expenses"

msgid "kpi.info.total_assets_basic_runway.def"
msgstr "Number of months the current level of total assets can cover the average monthly base expense, without additional income."

msgid "kpi.info.total_assets_basic_runway.formula"
msgstr "Total assets / Average monthly base expense"

msgid "kpi.info.net_worth.name"
msgstr "Net worth"

msgid "kpi.info.net_worth.def"
msgstr "Accumulated net value: difference between total assets and total liabilities. Reflects actual available wealth."

msgid "kpi.info.net_worth.formula"
msgstr "Total assets − Total liabilities"

msgid "kpi.info.top_asset.name"
msgstr "Top asset concentration"

msgid "kpi.info.top_asset.def"
msgstr "Percentage weight of the highest-balance asset over total assets. Very high values indicate low diversification."

msgid "kpi.info.top_asset.formula"
msgstr "Top asset balance / Total assets"

msgid "kpi.info.top_expense.name"
msgstr "Top expense concentration"

msgid "kpi.info.top_expense.def"
msgstr "Percentage weight of the most significant expense category over total expenses for the period."

msgid "kpi.info.top_expense.formula"
msgstr "Top expense category / Total expenses"

msgid "kpi.info.delta_net_worth.name"
msgstr "Net worth delta"

msgid "kpi.info.delta_net_worth.def"
msgstr "Projected difference in net worth at the end of the horizon between the scenario with series and the base scenario."

msgid "kpi.info.delta_net_worth.formula"
msgstr "Net worth (with series) − Net worth (base)"

msgid "kpi.info.delta_runway.name"
msgstr "Runway delta"

msgid "kpi.info.delta_runway.def"
msgstr "Projected difference in runway months at the end of the horizon between the scenario with series and the base scenario."

msgid "kpi.info.delta_runway.formula"
msgstr "Runway (with series) − Runway (base)"

